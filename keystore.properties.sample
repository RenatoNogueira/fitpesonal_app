# Normalmente você NÃO precisa preencher isto à mão: rode  powershell -ExecutionPolicy Bypass -File scripts\gerar-keystore.ps1
# (gera a chave e o keystore.properties com senha aleatória). Nunca versione senhas nem o .jks.
# storeFile é relativo à pasta raiz do projeto (rje-android).
storeFile=fitpersonal-release.jks
storePassword=
keyAlias=fitpersonal
keyPassword=
